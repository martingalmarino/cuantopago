---
import SubscriptionCount from './SubscriptionCount';
const path = Astro.url.pathname;
const links = [
  { href: '/plataformas/', label: 'Plataformas' },
  { href: '/calculadora/', label: 'Calculadora' },
  { href: '/gestionar-suscripciones/', label: 'Gestionar suscripciones' },
  { href: '/mis-suscripciones/', label: 'Mis suscripciones', count: true },
];
const inGuides = path.startsWith('/guias/') || /^\/[a-z0-9-]+\/cancelar\/$/.test(path);
const isCurrent = (href: string) => path === href || (href === '/gestionar-suscripciones/' && inGuides);
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="8" cy="8" r="5.2" />
          <path d="M8 4.8v6.4M6.2 6.4h2.5a1.4 1.4 0 0 1 0 2.8H6.2" />
        </svg>
      </span>
      Abonito
    </a>
    <nav class="nav nav-desktop" aria-label="Principal">
      {links.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
          {link.label}
          {link.count && <SubscriptionCount client:only="react" />}
        </a>
      ))}
    </nav>
    <details class="nav-mobile">
      <summary>Menú</summary>
      <nav class="nav-links nav" aria-label="Principal en el teléfono">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
            {link.count && <SubscriptionCount client:only="react" />}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
  if (menu) {
    const close = () => { menu.open = false; };
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) close();
    });
    window.addEventListener('pageshow', close);
  }
</script>
