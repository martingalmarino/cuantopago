---
import SubscriptionCount from './SubscriptionCount';
const path = Astro.url.pathname;
const links = [
  { href: '/plataformas/', label: 'Plataformas' },
  { href: '/calculadora/', label: 'Calculadora' },
  { href: '/gestionar-suscripciones/', label: 'Gestionar suscripciones' },
  { href: '/mis-suscripciones/', label: 'Mis suscripciones', count: true },
  { href: '/asistente/', label: 'Chat' },
];
const inGuides = path.startsWith('/guias/') || /^\/[a-z0-9-]+\/cancelar\/$/.test(path);
const isCurrent = (href: string) => path === href || (href === '/gestionar-suscripciones/' && inGuides);
---
<header class="site-header">
  <div class="header-inner">
    <a class="wordmark" href="/">
      <span class="mark" aria-hidden="true">
        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8">
          <circle cx="8" cy="8" r="5.2" />
          <path d="M8 4.8v6.4M6.2 6.4h2.5a1.4 1.4 0 0 1 0 2.8H6.2" />
        </svg>
      </span>
      Abonito
    </a>
    <div class="header-end">
      <nav class="nav nav-desktop" aria-label="Principal">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
            {link.count && <SubscriptionCount client:only="react" />}
          </a>
        ))}
      </nav>
      <button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" hidden>
        <span class="visually-hidden">Modo oscuro</span>
        <svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20.5 14.5A8.5 8.5 0 0 1 9.5 3.5a8.5 8.5 0 1 0 11 11z" /></svg>
        <svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
      </button>
    </div>
    <details class="nav-mobile">
      <summary>Menú</summary>
      <nav class="nav-links nav" aria-label="Principal en el teléfono">
        {links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
            {link.count && <SubscriptionCount client:only="react" />}
          </a>
        ))}
      </nav>
    </details>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>('.nav-mobile');
  if (menu) {
    const close = () => { menu.open = false; };
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        close();
        menu.querySelector('summary')?.focus();
      }
    });
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) close();
    });
    window.addEventListener('pageshow', close);
  }

  const THEME_KEY = 'abonito:tema';
  const THEME_COLORS = { light: '#f4f5f5', dark: '#0d1110' };
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  if (toggle) {
    const root = document.documentElement;
    const systemDark = window.matchMedia('(prefers-color-scheme: dark)');
    const stored = () => {
      try {
        const value = localStorage.getItem(THEME_KEY);
        return value === 'light' || value === 'dark' ? value : null;
      } catch {
        return null;
      }
    };
    const apply = (theme: 'light' | 'dark') => {
      root.dataset.theme = theme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', THEME_COLORS[theme]);
      toggle.setAttribute('aria-pressed', String(theme === 'dark'));
      toggle.title = theme === 'dark' ? 'Cambiar a modo claro' : 'Cambiar a modo oscuro';
    };
    apply(root.dataset.theme === 'dark' ? 'dark' : 'light');
    toggle.hidden = false;
    toggle.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      apply(next);
      try {
        localStorage.setItem(THEME_KEY, next);
      } catch {
        // Sin almacenamiento la elección dura hasta cambiar de página.
      }
    });
    systemDark.addEventListener('change', (event) => {
      if (!stored()) apply(event.matches ? 'dark' : 'light');
    });
  }
</script>
