---
import BrandLogo from './BrandLogo.astro';
import { categoryLabels, lowestPublishedPlan, monthlyPublishedMinor, publishedContext, searchText, todayIso } from '../lib/catalog';
import { formatMinor } from '../lib/money';
import type { ServiceRecord } from '../lib/types';

interface Props { service: ServiceRecord }
const { service } = Astro.props;
const asOf = todayIso();
const offer = lowestPublishedPlan(service.id, asOf);
const plan = offer.plan;
---
<article
  class="card"
  data-search={searchText(service)}
  data-category={service.category}
  data-secondary={(service.secondaryCategories ?? []).join(' ')}
>
  <BrandLogo name={service.name} logo={service.logo} size="card" />
  <p class="kicker">{categoryLabels[service.category]}{(service.tags ?? []).length > 0 ? ` · ${service.tags?.join(' · ')}` : ''}</p>
  <h2>{service.name}</h2>
  {plan && plan.amountMinor !== null && plan.currency ? (
    <>
      <p class="price nums">{formatMinor(monthlyPublishedMinor(plan) ?? plan.amountMinor, plan.currency)}{plan.billingPeriodMonths === 1 ? '' : ' / mes'}</p>
      <p class="meta">{plan.name} · {publishedContext(plan)}{plan.billingPeriodMonths === 1 ? '' : ` Total del período: ${formatMinor(plan.amountMinor, plan.currency)}.`}</p>
      {plan.verifiedAt && <p class="meta">Verificado el {plan.verifiedAt}.</p>}
      <p class="warning" hidden data-verified={plan.verifiedAt} data-freshness-days="30">Este precio pasó los 30 días de revisión.</p>
    </>
  ) : (
    <p class="price">Precio pendiente de verificación</p>
  )}
  <div class="card-actions">
    <a class="btn" href={`/${service.slug}/`}>Ver planes</a>
    <button class="btn primary" type="button" data-add-service={service.id}>Agregar</button>
  </div>
</article>
