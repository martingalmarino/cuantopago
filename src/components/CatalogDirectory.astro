---
import ServiceRow from './ServiceRow.astro';
import { categoryLabels, services } from '../lib/catalog';
import type { CategoryId } from '../lib/types';

interface Props { heading?: string }
const { heading } = Astro.props;
const order: CategoryId[] = [
  'series', 'musica', 'almacenamiento', 'paquetes', 'deportes', 'tv-en-vivo', 'productividad', 'diseno', 'inteligencia-artificial',
];

const groups = order
  .map((id) => ({
    id,
    label: categoryLabels[id],
    primary: services.filter((service) => service.category === id),
    extra: services.filter((service) => service.category !== id && (service.secondaryCategories ?? []).includes(id)),
  }))
  .filter((group) => group.primary.length > 0 || group.extra.length > 0);
---
<div id="catalogo">
  {heading && <h1 style="margin-bottom:8px">{heading}</h1>}
  <div class="toolbar">
    <label class="search">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3-3"/></svg>
      <span class="kicker" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Buscar plataforma</span>
      <input id="q" type="search" placeholder="Buscar plataforma" autocomplete="off" />
    </label>
    <label class="field">
      <span class="kicker" style="position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)">Categoría</span>
      <select id="category" aria-label="Categoría">
        <option value="todas">Todas</option>
        {order.map((id) => <option value={id}>{categoryLabels[id]}</option>)}
      </select>
    </label>
  </div>
  <p id="result-count" class="meta" aria-live="polite">{services.length} plataformas</p>
  <div class="directory">
    {groups.map((group) => (
      <section class="section-panel" data-panel={group.id}>
        <div class="section-cap">
          <h2>{group.label}</h2>
          <span class="count" data-panel-count>{group.primary.length}</span>
        </div>
        <div class="section-body">
          {group.primary.map((service) => <ServiceRow service={service} />)}
          {group.extra.map((service) => <ServiceRow service={service} extraCategory={group.id} />)}
        </div>
      </section>
    ))}
  </div>
  <p id="empty" class="warning" hidden>No hay resultados. <a href="/calculadora/">Cargá el importe a mano</a>.</p>
</div>
<script>
  import { fold } from '../lib/search';
  const input = document.querySelector<HTMLInputElement>('#q');
  const select = document.querySelector<HTMLSelectElement>('#category');
  const rows = [...document.querySelectorAll<HTMLElement>('.service-row')];
  const panels = [...document.querySelectorAll<HTMLElement>('[data-panel]')];
  const empty = document.querySelector<HTMLElement>('#empty');
  const count = document.querySelector('#result-count');
  function apply() {
    const query = fold(input?.value ?? '');
    const category = select?.value ?? 'todas';
    let visible = 0;
    for (const row of rows) {
      const extra = row.dataset.extra ?? '';
      const primary = row.dataset.primary ?? '';
      const matchesCategory = category === 'todas' ? extra === '' : primary === category || extra === category;
      const matchesQuery = !query || (row.dataset.search ?? '').includes(query);
      const show = matchesCategory && matchesQuery;
      row.hidden = !show;
      if (show) visible += 1;
    }
    for (const panel of panels) {
      const shown = [...panel.querySelectorAll<HTMLElement>('.service-row')].filter((row) => !row.hidden);
      panel.hidden = shown.length === 0;
      const badge = panel.querySelector('[data-panel-count]');
      if (badge) badge.textContent = String(shown.length);
    }
    if (count) count.textContent = `${visible} ${visible === 1 ? 'plataforma' : 'plataformas'}`;
    if (empty) empty.hidden = visible !== 0;
  }
  input?.addEventListener('input', apply);
  select?.addEventListener('change', apply);
</script>
