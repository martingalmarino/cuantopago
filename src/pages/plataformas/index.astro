---
import Base from '../../layouts/Base.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { services } from '../../lib/catalog';
---
<Base
  title="Plataformas y planes en Argentina"
  description="Catálogo de suscripciones de series, música y almacenamiento con el precio publicado y la fecha en que lo verificamos."
  crumbs={[{ name: 'Inicio', href: '/' }, { name: 'Plataformas', href: '/plataformas/' }]}
>
  <div class="wrap page page-stack">
    <nav class="crumbs" aria-label="Migas"><a href="/">Inicio</a> <span>/</span> <span>Plataformas</span></nav>
    <header class="sheet">
      <h1>Plataformas</h1>
      <p class="prose">El precio que ves es el publicado por cada empresa, con la fecha de verificación. Si no pudimos confirmarlo, lo decimos y podés anotar lo que te cobran.</p>
    </header>
    <div class="cards">
      {services.map((service) => <ServiceCard service={service} />)}
    </div>
  </div>
</Base>
