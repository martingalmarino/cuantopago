---
import Base from '../layouts/Base.astro';
import BrandLogo from '../components/BrandLogo.astro';
import ServiceRow from '../components/ServiceRow.astro';
import Calculator from '../components/Calculator';
import { categoryLabels, monthlyPublishedMinor, plansFor, reviewedLabel, serviceById, services } from '../lib/catalog';
import { formatPrice } from '../lib/money';
import type { PlanRecord } from '../lib/types';

export function getStaticPaths() {
  return services.map((service) => ({ params: { slug: service.slug }, props: { service } }));
}
const { service } = Astro.props;
const list = plansFor(service.id);
const h1 = `${service.name} en Argentina`;
const title = service.seoTitle ?? `Cuánto cuesta ${service.name} en Argentina`;
const description = service.seoDescription ?? `Precio publicado de ${service.name} en Argentina, planes y qué entra en la estimación.`;
const firstPriced = list.find((plan) => plan.selectable !== false && plan.amountMinor !== null && (plan.choiceSlots ?? 0) === 0);
const verified = list.find((plan) => plan.verifiedAt)?.verifiedAt ?? null;
const bundles = list.filter((plan) => (plan.entitlements?.length ?? 0) > 0 || (plan.choiceOptions?.length ?? 0) > 0);
const related = services.filter((item) => item.category === service.category && item.id !== service.id).slice(0, 4);
const groups = [
  { label: 'Por mes', plans: list.filter((plan) => !plan.billingIntervalDays && plan.billingPeriodMonths === 1) },
  { label: 'Pago anual', plans: list.filter((plan) => !plan.billingIntervalDays && plan.billingPeriodMonths > 1) },
  { label: 'Ciclo en días', plans: list.filter((plan) => Boolean(plan.billingIntervalDays)) },
].filter((group) => group.plans.length > 0);

function featureLine(plan: PlanRecord): string {
  const bits = [
    plan.features.ads === true ? 'Con anuncios' : plan.features.ads === false ? 'Sin anuncios' : null,
    plan.features.maxResolution,
    plan.features.simultaneousPlayback ? `${plan.features.simultaneousPlayback} ${plan.features.simultaneousPlayback === 1 ? 'pantalla' : 'pantallas'}` : null,
    plan.features.storage,
    plan.features.memberLimit ? `${plan.features.memberLimit} ${plan.features.memberLimit === 1 ? 'persona' : 'personas'}` : null,
  ].filter(Boolean);
  return bits.slice(0, 3).join(' · ');
}
function priceLabel(plan: PlanRecord): string {
  if (plan.amountMinor === null || !plan.currency) return 'Precio a confirmar';
  const amount = formatPrice(plan.amountMinor, plan.currency);
  if (plan.billingIntervalDays) return `${amount} / ${plan.billingIntervalDays} días`;
  if (plan.billingPeriodMonths === 12) return `${amount} / año`;
  if (plan.billingPeriodMonths > 1) return `${amount} / ${plan.billingPeriodMonths} meses`;
  return `${amount} / mes`;
}
---
<Base
  title={title}
  description={description}
  crumbs={[{ name: 'Inicio', href: '/' }, { name: 'Plataformas', href: '/plataformas/' }, { name: service.name, href: `/${service.slug}/` }]}
>
  <div class="wrap page page-stack">
    <nav class="crumbs" aria-label="Migas">
      <a href="/">Inicio</a> <span>/</span> <a href="/plataformas/">Plataformas</a> <span>/</span> <span>{service.name}</span>
    </nav>
    <header class="identity">
      <BrandLogo name={service.name} logo={service.logo} size="header" />
      <div>
        <p class="kicker">{categoryLabels[service.category]}{(service.tags ?? []).length ? ` · ${service.tags?.join(' · ')}` : ''}</p>
        <h1>{h1}</h1>
        <p class="meta clamp-2">{service.description}</p>
        {reviewedLabel(verified) && <p class="meta">{reviewedLabel(verified)}</p>}
        <p class="meta"><a href={service.officialUrl} rel="noopener noreferrer">Sitio oficial</a></p>
      </div>
    </header>
    <div class="decision">
      <section class="section-panel">
        <div class="section-cap">
          <h2>Elegí tu plan</h2>
          <a class="see-calc" href="#calculo">Ver cálculo</a>
        </div>
        <div class="section-body">
          {list.length === 0 ? (
            <p class="meta" style="padding:12px">Precio a confirmar. Cargá lo que te cobran en el cálculo.</p>
          ) : groups.map((group) => (
            <div>
              {groups.length > 1 && <p class="group-label">{group.label}</p>}
              {group.plans.map((plan, index) => (
                <label class="plan-option">
                  <input
                    type="radio"
                    name="plan"
                    value={plan.id}
                    data-priced={plan.amountMinor !== null && (plan.choiceSlots ?? 0) === 0 ? 'true' : 'false'}
                    checked={plan.id === firstPriced?.id || (!firstPriced && index === 0 && group === groups[0]) ? true : undefined}
                  />
                  <span>
                    <strong>{plan.name}</strong>
                    <span class="meta">{featureLine(plan) || 'Sin condiciones publicadas en esta ficha.'}</span>
                  </span>
                  <span class="plan-price nums">{priceLabel(plan)}</span>
                </label>
              ))}
            </div>
          ))}
        </div>
      </section>
      <Calculator client:load serviceId={service.id} initialPlanId={firstPriced?.id} embedded />
    </div>
    {list.some((plan) => featureLine(plan) || plan.notes || plan.promotion) && (
      <section class="section-panel">
        <div class="section-cap"><h2>Detalle de los planes</h2></div>
        <div class="section-body pad">
          {list.map((plan) => (
            <article class="include-row" style="display:block;padding:12px 0">
              <strong>{plan.name}</strong>
              <p class="meta">{featureLine(plan)}</p>
              {plan.amountMinor !== null && plan.currency && plan.billingPeriodMonths > 1 && (
                <p class="meta">Equivalente mensual: {formatPrice(monthlyPublishedMinor(plan) ?? plan.amountMinor, plan.currency)}. No es una cuota.</p>
              )}
              {plan.promotion && (
                <p class="meta">Promo {formatPrice(plan.promotion.amountMinor, plan.promotion.currency)} por {plan.promotion.durationCycles} ciclos. El presupuesto usa la lista salvo que la actives.</p>
              )}
              {plan.notes && <p class="meta">{plan.notes}</p>}
            </article>
          ))}
        </div>
      </section>
    )}
    {bundles.length > 0 && (
      <section class="section-panel">
        <div class="section-cap"><h2>Incluye</h2></div>
        <div class="section-body pad">
          {service.overlapNote && <p class="warning">{service.overlapNote}</p>}
          {bundles.map((plan) => (
            <div>
              <h3>{plan.name}</h3>
              {(plan.entitlements ?? []).map((item) => {
                const included = item.serviceId ? serviceById(item.serviceId) : undefined;
                return (
                  <p class="include-row">
                    {included && <BrandLogo name={included.name} logo={included.logo} size="mini" />}
                    <span>{item.label}. Entra en el cargo de este plan.</span>
                  </p>
                );
              })}
              {(plan.choiceSlots ?? 0) > 0 && (
                <p class="meta">Elegís exactamente {plan.choiceSlots}: {(plan.choiceOptions ?? []).map((option) => option.label).join(', ')}.</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}
    {service.body && <p class="prose">{service.body}</p>}
    <section class="section-panel">
      <div class="section-cap"><h2>Fuentes</h2></div>
      <div class="section-body pad">
        <ul>
          {service.sourceUrls.map((url) => <li><a href={url}>{url}</a></li>)}
        </ul>
      </div>
    </section>
    <section class="section-panel">
      <div class="section-cap"><h2>Preguntas frecuentes</h2></div>
      <div class="section-body pad">
        {service.faqs.map((faq) => (
          <details class="breakdown">
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
        <p><button type="button" class="btn" id="copy-report">Copiar resumen para reportar un precio</button></p>
        <p id="copy-status" class="meta" aria-live="polite"></p>
      </div>
    </section>
    {related.length > 0 && (
      <section class="section-panel">
        <div class="section-cap"><h2>Otras de {categoryLabels[service.category]}</h2></div>
        <div class="section-body">
          {related.map((item) => <ServiceRow service={item} />)}
        </div>
      </section>
    )}
  </div>
</Base>
<script>
  const radios = [...document.querySelectorAll<HTMLInputElement>('input[name="plan"]')];
  function publish(input: HTMLInputElement) {
    document.dispatchEvent(new CustomEvent('cuanto-pago:select-plan', {
      detail: { id: input.value, priced: input.dataset.priced === 'true' },
    }));
  }
  for (const input of radios) {
    input.addEventListener('change', () => publish(input));
  }
  const selected = radios.find((input) => input.checked);
  if (selected) publish(selected);
</script>
<script define:vars={{ serviceName: service.name, serviceSlug: service.slug }}>
  const button = document.querySelector('#copy-report');
  const status = document.querySelector('#copy-status');
  button?.addEventListener('click', async () => {
    const text = `Cuánto Pago — precio para revisar\nServicio: ${serviceName}\nFicha: /${serviceSlug}/\nNo se envió a ningún lado: copialo y mandalo por el canal que uses.`;
    try {
      await navigator.clipboard.writeText(text);
      if (status) status.textContent = 'Copiado. No se envió a ningún lado.';
    } catch {
      if (status) status.textContent = text;
    }
  });
</script>
