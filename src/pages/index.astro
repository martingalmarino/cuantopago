---
import Base from '../layouts/Base.astro';
import CatalogDirectory from '../components/CatalogDirectory.astro';
import BudgetDock from '../components/BudgetDock';
import { services } from '../lib/catalog';
---
<Base
  title="Cuánto Pago | Suscripciones en Argentina"
  description="Compará planes, calculá el costo estimado y organizá tu gasto mensual en suscripciones."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: 'Cuánto Pago',
    description: 'Compará planes, calculá el costo estimado y organizá tu gasto mensual.',
    inLanguage: 'es-AR',
  }}
>
  <div class="wrap has-budget-bar">
    <section class="intro">
      <h1>¿Cuánto pagás por tus suscripciones?</h1>
      <p>Compará planes, calculá el costo estimado y organizá tu gasto mensual.</p>
    </section>
    <div class="utility">
      <section class="section-panel">
        <div class="section-cap"><h2>Calculá una suscripción</h2></div>
        <form class="section-body pad stack" id="launcher" onsubmit="return false">
          <label class="field">
            <span>Plataforma</span>
            <select id="launcher-service">
              {services.map((service) => <option value={service.slug}>{service.name}</option>)}
            </select>
          </label>
          <a class="btn primary" id="launcher-go" href={`/${services[0]?.slug}/`}>Ver cálculo</a>
        </form>
      </section>
      <BudgetDock client:only="react" />
    </div>
    <CatalogDirectory />
    <p class="meta" style="margin-top:20px"><a href="/como-calculamos/">Cómo calculamos los totales</a></p>
  </div>
</Base>
<script>
  const select = document.querySelector<HTMLSelectElement>('#launcher-service');
  const go = document.querySelector<HTMLAnchorElement>('#launcher-go');
  select?.addEventListener('change', () => {
    if (go && select.value) go.href = `/${select.value}/`;
  });
</script>
